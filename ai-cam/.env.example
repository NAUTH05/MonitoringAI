# ─────────────────────────────────────────────────────────────────────────────
# AI-Cam local runtime configuration. Copy to `ai-cam/.env` and edit.
# `ai-cam/.env` is gitignored and must never be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Camera source ────────────────────────────────────────────────────────────
# webcam  = laptop/attached camera (development)
# rtsp    = direct IP camera / NVR URL (production)
# go2rtc  = consume the go2rtc re-stream over RTSP (single shared producer)
CAMERA_SOURCE_TYPE=webcam
WEBCAM_DEVICE=0
WEBCAM_BACKEND=dshow
WEBCAM_WIDTH=1280
WEBCAM_HEIGHT=720
WEBCAM_FPS=30
# CAMERA_URL=rtsp://admin:password@192.168.1.10:554/Streaming/Channels/101
RTSP_TRANSPORT=tcp
CAMERA_RECONNECT_DELAY=2

# ── Identity / cadence ───────────────────────────────────────────────────────
# STREAM_ID is written into the AI-Cam events.stream_id column. Keep it equal to
# the go2rtc stream name (or embedded in the MonitoringAI camera rtsp_url) so
# MonitoringAI can map the event to a camera deterministically.
STREAM_ID=laptop_webcam
# Which AI task to run: license_plate | intrusion
AI_TASK_NAME=license_plate
AI_PROCESSING_FPS=5

# ── License-plate models (paths are relative to the ai-cam/ directory) ───────
VEHICLE_MODEL_PATH=vehicle_model.pt
PLATE_MODEL_PATH=plate_model.pt
VEHICLE_ENGINE_PATH=vehicle_model.engine
PLATE_ENGINE_PATH=plate_model.engine
TROCR_MODEL_DIR=trocr_vn_plate_final

# ── Intrusion person model (used when AI_TASK_NAME=intrusion) ────────────────
# A YOLO detector that exposes a class named "person". The COCO-pretrained
# model shipped at models/intrusion/person_model.pt works out of the box; a
# custom single-class model trained by scripts/train_person_detector.py can
# replace it (same path).
PERSON_MODEL_PATH=models/intrusion/person_model.pt
PERSON_ENGINE_PATH=models/intrusion/person_model.engine
PERSON_CONF_THRESH=0.35

# ── Model runtime ────────────────────────────────────────────────────────────
AI_PREFER_TENSORRT=true
# auto | cuda | cpu
AI_DEVICE=auto
AI_USE_FP16=true

# ── License-plate thresholds ─────────────────────────────────────────────────
VEHICLE_CONF_THRESH=0.5
PLATE_CONF_THRESH=0.4
MIN_PLATE_LENGTH=6
MAX_PLATE_LENGTH=9
TRACK_STALE_FRAMES=30
PLATE_CROP_PADDING=2
MIN_PLATE_CROP_W=16
MIN_PLATE_CROP_H=8
MIN_PLATE_ASPECT=0.15
MAX_PLATE_ASPECT=8.0

# ── Intrusion ROI / event thresholds ─────────────────────────────────────────
# INTRUSION is decided by the fraction of the person's BOUNDING BOX that
# overlaps the ROI polygon:  roiOverlap = area(bbox ∩ roi) / area(bbox).
# A person counts as "inside" when roiOverlap >= INTRUSION_OVERLAP_THRESHOLD.
# (The denominator is the PERSON bbox area, NOT the ROI area and NOT IoU.)
# This is robust for distant/elevated CCTV where the feet may not be visible.
#   0.05 = very sensitive (fires when the person barely enters)
#   0.15 = recommended default
#   0.30 = requires a significant part of the body bbox to enter
#   0.50 = requires roughly half the bbox inside
# Range 0.0 .. 1.0 (clamped).
INTRUSION_OVERLAP_THRESHOLD=0.15
# Consecutive processed frames the person must overlap the ROI before an
# intrusion is confirmed (debounce).
INTRUSION_MIN_INSIDE_FRAMES=3
# Minimum wall-clock dwell inside the ROI (ms) before confirming (0 = disabled).
INTRUSION_DWELL_MS=1000
# Minimum time (ms) between two events for the SAME track.
INTRUSION_EVENT_COOLDOWN_MS=5000
# Consecutive outside frames before a track is considered EXITED (re-armed).
INTRUSION_ROI_EXIT_FRAMES=5
# Processed frames without seeing a track before its state is dropped.
INTRUSION_TRACK_LOST_FRAMES=30

# ── ROI configuration source (normalized polygon, 0..1 of the video frame) ───
# config = poll MonitoringAI GET /api/cameras/:id/ai-config (recommended)
# static = read once from AI_ROI_FILE / AI_ROI_POLYGON (offline testing)
AI_ROI_SOURCE=config
# Poll interval (seconds) for AI_ROI_SOURCE=config. ROI edits apply without
# restarting the neural network.
AI_ROI_POLL_SECONDS=5
# Fallback/offline ROI:
# AI_ROI_FILE=data/roi.json
# AI_ROI_POLYGON=[{"x":0.12,"y":0.24},{"x":0.80,"y":0.22},{"x":0.85,"y":0.80},{"x":0.15,"y":0.85}]

# ── Evidence storage ─────────────────────────────────────────────────────────
# local | minio
AI_CAM_STORAGE_MODE=local
AI_CAM_STORAGE_DIR=data/events
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=events
# MINIO_SECURE=false

# ── AI-Cam database ──────────────────────────────────────────────────────────
AI_CAM_DB_ENABLED=true
AICAM_DATABASE_URL=postgresql://monitoring:monitoring_pass@localhost:5432/aicam

# ── MonitoringAI push (needed for intrusion events + ROI config) ─────────────
# Requires all three for event push. MONITORING_CAMERA_ID is also required for
# AI_ROI_SOURCE=config (the ROI is read from that camera's INTRUSION module).
# MONITORING_API_URL=http://localhost:4000/api
# MONITORING_API_KEY=demo-camera-key-change-me
# MONITORING_CAMERA_ID=<uuid of the MonitoringAI camera>
# MONITORING_MEDIA_BASE_URL=http://localhost:4000

# ── Diagnostics ──────────────────────────────────────────────────────────────
STATUS_SERVER_ENABLED=true
STATUS_SERVER_HOST=127.0.0.1
STATUS_SERVER_PORT=8090
PREVIEW_JPEG_QUALITY=80
LOG_LEVEL=INFO
