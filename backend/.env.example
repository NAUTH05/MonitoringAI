DATABASE_URL="postgresql://monitoring:monitoring_pass@localhost:5432/smart_monitoring"
AICAM_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aicam"
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
PORT=4000
FRONTEND_URL="http://localhost:3000"
NODE_ENV="development"
# API key required for Camera AI to POST events and heartbeat (x-api-key header)
CAMERA_API_KEY="demo-camera-key-change-me"
# go2rtc REST API base URL (used by the stream management proxy)
GO2RTC_API_URL="http://localhost:1984"
# MinIO Public Bucket URL for AI Cam images (e.g., http://your-vps-ip:9000/events or https://minio.domain.com/events)
MINIO_PUBLIC_URL="http://localhost:9000/events"
