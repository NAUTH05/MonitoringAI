# ─────────────────────────────────────────────────────────────────────────────
# MonitoringAI backend configuration. Copy to `backend/.env` and edit.
# `backend/.env` is gitignored and must never be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Databases (local PostgreSQL defaults) ────────────────────────────────────
# MonitoringAI application DB (users, cameras, modules, events, alerts, ...).
# NOTE: the existing schema/dataset name is `smart_monitoring` — keep it unless
# you also update every DATABASE_URL reference.
DATABASE_URL="postgresql://monitoring:monitoring_pass@localhost:5432/smart_monitoring"
# Separate AI-Cam DB (AI event rows: license-plate + intrusion). See ai-cam/README.md.
AICAM_DATABASE_URL="postgresql://monitoring:monitoring_pass@localhost:5432/aicam"
# Local AI-Cam evidence directory served via /api/aicam-media.
# Path is resolved from the backend/ working directory (where npm start runs).
AICAM_EVENTS_DIR="../ai-cam/data/events"

# ── Auth / server ────────────────────────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
PORT=4000
FRONTEND_URL="http://localhost:3000"
NODE_ENV="development"

# ── Machine-to-machine API key (AI-Cam -> backend) ───────────────────────────
# Required by the AI camera to POST /api/events, POST /api/cameras/:id/heartbeat
# and GET /api/cameras/:id/ai-config (x-api-key header).
# The Python AI runtime uses the SAME key (ai-cam/.env MONITORING_API_KEY).
CAMERA_API_KEY="demo-camera-key-change-me"

# ── go2rtc (internal stream gateway) ─────────────────────────────────────────
# REST API used by the backend to manage streams (camera add/edit orchestration).
GO2RTC_API_URL="http://localhost:1984"
# RTSP re-stream base. The AI runtime consumes rtsp://<base>/<streamName>, so the
# runtime-config endpoint derives each camera's AI source URL from this.
GO2RTC_RTSP_URL="rtsp://127.0.0.1:8554"

# ── Optional: MinIO public bucket for AI-Cam images ──────────────────────────
# Leave unset for local development to serve images from AICAM_EVENTS_DIR.
# MINIO_PUBLIC_URL="http://localhost:9000/events"
# MINIO_HOST=127.0.0.1
# MINIO_PORT=9000
# MINIO_BUCKET=events

# ── AI Search: credential encryption ─────────────────────────────────────────
# AES-256-GCM key used to encrypt secrets stored in the database (Gemini API key,
# Telegram bot token). Generate once and keep it stable:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, JWT_SECRET is used as a fallback (with a startup warning) — rotating
# JWT_SECRET then makes saved credentials unreadable and they must be re-entered.
SETTINGS_ENCRYPTION_KEY=""

# ── Telegram alerts: token encryption (Settings → Telegram Bots) ────────────
# Dedicated AES-256-GCM key for Telegram bot tokens. Generate once and keep it
# stable — rotating it makes every stored bot token unreadable (admins must
# re-enter the token for each bot):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Optional: without it the backend falls back to SETTINGS_ENCRYPTION_KEY, then
# JWT_SECRET (with a warning). No Telegram configuration is required to start
# the app — bots are added entirely from the dashboard.
TELEGRAM_ENCRYPTION_KEY=""

# How often the background delivery worker drains the PENDING queue (ms).
# 0 disables the worker (not recommended in production).
# TELEGRAM_WORKER_INTERVAL_MS=10000

# Public origin Telegram can reach to fetch evidence images for sendPhoto.
# Only needed when Event.imageUrl is a relative path; a URL Telegram cannot
# fetch simply degrades to a text-only message.
# TELEGRAM_MEDIA_BASE_URL="https://monitoring.example.com"

# ── AI Search: provider defaults (optional) ──────────────────────────────────
# Provider selection, model ids, API keys and the AI Search ON/OFF switch are all
# configured from the dashboard (Settings → AI Search) and stored encrypted in
# the `ai_settings` table. No environment variable is required for normal setup.
# These only seed the very first row if you prefer to bootstrap from env.
# AI_DEFAULT_PROVIDER="GEMINI"            # GEMINI | LOCAL
# AI_DEFAULT_GEMINI_MODEL="gemini-2.5-flash"
# AI_DEFAULT_GEMINI_VISION_MODEL="gemini-2.5-flash"
# AI_DEFAULT_GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
# AI_DEFAULT_LOCAL_ENDPOINT="http://127.0.0.1:11434"
# AI_DEFAULT_LOCAL_MODEL="qwen2.5:7b"

# ── Dashboard base URL used in notification links ────────────────────────────
# Configured from the UI (Notification Center) so operators can change it
# without editing files. Set here only if you want a fallback for new installs.
# DASHBOARD_BASE_URL="http://localhost:3000"
