# ─────────────────────────────────────────────────────────────────────────────
# MonitoringAI backend configuration. Copy to `backend/.env` and edit.
# `backend/.env` is gitignored and must never be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Databases (local PostgreSQL defaults) ────────────────────────────────────
# MonitoringAI application DB (users, cameras, modules, events, alerts, ...).
# NOTE: the existing schema/dataset name is `smart_monitoring` — keep it unless
# you also update every DATABASE_URL reference.
DATABASE_URL="postgresql://monitoring:monitoring_pass@localhost:5432/smart_monitoring"
# Separate AI-Cam DB (AI event rows: license-plate + intrusion). See ai-cam/README.md.
AICAM_DATABASE_URL="postgresql://monitoring:monitoring_pass@localhost:5432/aicam"
# Local AI-Cam evidence directory served via /api/aicam-media.
# Path is resolved from the backend/ working directory (where npm start runs).
AICAM_EVENTS_DIR="../ai-cam/data/events"

# ── Auth / server ────────────────────────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
PORT=4000
FRONTEND_URL="http://localhost:3000"
NODE_ENV="development"

# ── Machine-to-machine API key (AI-Cam -> backend) ───────────────────────────
# Required by the AI camera to POST /api/events, POST /api/cameras/:id/heartbeat
# and GET /api/cameras/:id/ai-config (x-api-key header).
# The Python AI runtime uses the SAME key (ai-cam/.env MONITORING_API_KEY).
CAMERA_API_KEY="demo-camera-key-change-me"

# ── go2rtc REST API base URL (stream management proxy) ───────────────────────
GO2RTC_API_URL="http://localhost:1984"

# ── Optional: MinIO public bucket for AI-Cam images ──────────────────────────
# Leave unset for local development to serve images from AICAM_EVENTS_DIR.
# MINIO_PUBLIC_URL="http://localhost:9000/events"
# MINIO_HOST=127.0.0.1
# MINIO_PORT=9000
# MINIO_BUCKET=events
