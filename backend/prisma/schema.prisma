generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id        String   @id @default(uuid())
  name      String   @unique
  users     User[]
  createdAt DateTime @default(now()) @map("created_at")

  @@map("roles")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String
  roleId    String   @map("role_id")
  role      Role     @relation(fields: [roleId], references: [id])
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
  @@index([roleId])
}

enum CameraStatus {
  ONLINE
  OFFLINE
  ERROR
}

model Camera {
  id            String         @id @default(uuid())
  name          String
  location      String
  rtspUrl       String         @map("rtsp_url")
  status        CameraStatus   @default(OFFLINE)
  isActive      Boolean        @default(true) @map("is_active")
  lastHeartbeat DateTime?      @map("last_heartbeat")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  events        Event[]
  cameraModules CameraModule[]

  @@map("cameras")
  @@index([status])
  @@index([location])
}

model AiModule {
  id            String         @id @default(uuid())
  name          String         @unique
  code          String         @unique
  description   String?
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  cameraModules CameraModule[]

  @@map("ai_modules")
}

model CameraModule {
  id        String   @id @default(uuid())
  cameraId  String   @map("camera_id")
  moduleId  String   @map("module_id")
  isEnabled Boolean  @default(true) @map("is_enabled")
  camera    Camera   @relation(fields: [cameraId], references: [id])
  module    AiModule @relation(fields: [moduleId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([cameraId, moduleId])
  @@map("camera_modules")
  @@index([cameraId])
  @@index([moduleId])
}

enum EventType {
  INTRUSION
  FIRE
  SMOKE
  PPE
  FACE
  VEHICLE
}

enum AlertStatus {
  UNREAD
  READ
  ACKNOWLEDGED
}

model Event {
  id         String    @id @default(uuid())
  cameraId   String    @map("camera_id")
  eventType  EventType @map("event_type")
  confidence Float
  imageUrl   String?   @map("image_url")
  videoUrl   String?   @map("video_url")
  timestamp  DateTime  @default(now())
  isAlert    Boolean   @default(false) @map("is_alert")
  camera     Camera    @relation(fields: [cameraId], references: [id])
  alert      Alert?
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("events")
  @@index([cameraId])
  @@index([eventType])
  @@index([timestamp])
  @@index([isAlert])
}

model Alert {
  id             String      @id @default(uuid())
  eventId        String      @unique @map("event_id")
  event          Event       @relation(fields: [eventId], references: [id])
  status         AlertStatus @default(UNREAD)
  acknowledgedAt DateTime?   @map("acknowledged_at")
  createdAt      DateTime    @default(now()) @map("created_at")

  @@map("alerts")
  @@index([status])
  @@index([createdAt])
}

model DashboardLayout {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  layout    Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("dashboard_layouts")
}

model SystemLog {
  id        String   @id @default(uuid())
  level     String
  message   String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("system_logs")
  @@index([level])
  @@index([createdAt])
}
