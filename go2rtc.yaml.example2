streams:
  # ── Hikvision NVR ────────────────────────────────────────────────────────────
  # Main stream (1080p): Channels/101, 201, 301 ...
  # Sub stream  (D1):    Channels/102, 202, 302 ...
  # nvr_ch1: rtsp://admin:password@192.168.1.200:554/Streaming/Channels/101
  # nvr_ch2: rtsp://admin:password@192.168.1.200:554/Streaming/Channels/201
  # nvr_ch3: rtsp://admin:password@192.168.1.200:554/Streaming/Channels/301

  # ── Dahua NVR ─────────────────────────────────────────────────────────────────
  # nvr_ch1: rtsp://admin:password@192.168.1.200:554/cam/realmonitor?channel=1&subtype=0
  # nvr_ch2: rtsp://admin:password@192.168.1.200:554/cam/realmonitor?channel=2&subtype=0

  # ── Camera trực tiếp (không qua NVR) ─────────────────────────────────────────
  # cam_gate: rtsp://admin:password@192.168.1.101:554/stream

api:
  listen: ":1984"
  origin: "*"

log:
  level: info
